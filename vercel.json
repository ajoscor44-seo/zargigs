{
  "framework": "vite",
  "installCommand": "cd frontend/app && npm install --prefer-offline --no-audit --no-fund",
  "buildCommand": "cd frontend/app && npm run build",
  "outputDirectory": "frontend/app/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

